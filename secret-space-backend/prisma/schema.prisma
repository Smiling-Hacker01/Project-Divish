generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  fcmToken     String?  @map("fcm_token")
  publicKey    String?  @map("public_key")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  coupleAsA        Couple?          @relation("UserA")
  coupleAsB        Couple?          @relation("UserB")
  faceDescriptor   FaceDescriptor?
  diaryEntries     DiaryEntry[]
  diaryReactions   DiaryReaction[]
  moods            Mood[]
  createdCoupons   Coupon[]         @relation("CouponCreator")
  receivedCoupons  Coupon[]         @relation("CouponRecipient")
  vaultFiles       VaultFile[]
  authoredReasons  LoveReason[]     @relation("ReasonAuthor")
  receivedReasons  LoveReason[]     @relation("ReasonRecipient")
  sentMessages     Message[]        @relation("SentMessages")
  devices          Device[]
  recoveryKeyEnvelopes RecoveryKeyEnvelope[]
  recoveryConversationEnvelopes RecoveryConversationEnvelope[]

  @@map("users")
}

model Couple {
  id              String    @id @default(uuid())
  userA           User      @relation("UserA", fields: [userAId], references: [id])
  userAId         String    @unique @map("user_a_id")
  userB           User?     @relation("UserB", fields: [userBId], references: [id])
  userBId         String?   @unique @map("user_b_id")
  coupleCode      String    @unique @map("couple_code")
  anniversaryDate DateTime? @map("anniversary_date") @db.Date
  // User A Settings
  userALoveBotMode String @default("off") @map("user_a_lovebot_mode") // off | daily | surprise
  userALoveBotTime String @default("09:00") @map("user_a_lovebot_time")
  
  // User B Settings
  userBAccessGranted Boolean @default(false) @map("user_b_access_granted")
  userBLoveBotMode   String @default("off") @map("user_b_lovebot_mode")
  userBLoveBotTime   String @default("09:00") @map("user_b_lovebot_time")
  couplePhoto     String?   @map("couple_photo")
  createdAt       DateTime  @default(now()) @map("created_at")
  status          String    @default("waiting") // waiting | active

  // Relations
  diaryEntries DiaryEntry[]
  moods        Mood[]
  coupons      Coupon[]
  loveReasons  LoveReason[]
  messages     Message[]
  keyEpochs    ConversationKeyEpoch[]
  recoveryConversationEnvelopes RecoveryConversationEnvelope[]

  @@map("couples")
}

model FaceDescriptor {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @unique @map("user_id")
  descriptor Float[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("face_descriptors")
}

model DiaryEntry {
  id           String   @id @default(uuid())
  couple       Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId     String   @map("couple_id")
  author       User     @relation(fields: [authorId], references: [id])
  authorId     String   @map("author_id")
  // Client-supplied idempotency token. Combined with authorId via the unique index
  // below so retried diary submissions return the existing row instead of creating
  // duplicates. NULL allowed for legacy entries created before this column existed.
  clientId     String?  @map("client_id")
  type         String   // text | image | video
  content      String?  // plaintext body for text entries (nullable for media-only)
  mediaUrl     String?  @map("media_url")
  thumbnailUrl String?  @map("thumbnail_url")
  milestone    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  editedAt     DateTime? @map("edited_at")
  deletedAt    DateTime? @map("deleted_at")

  reactions DiaryReaction[]

  @@index([coupleId, createdAt])
  // NULLS DISTINCT in Postgres allows legacy NULL clientId rows to coexist.
  @@unique([authorId, clientId], name: "diary_author_client_id_unique")
  @@map("diary_entries")
}

model DiaryReaction {
  id          String   @id @default(uuid())
  entry       DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId     String   @map("entry_id")
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @map("user_id")
  type        String   // heart | comment | reaction
  commentText String?  @map("comment_text")
  emoji       String?  // The emoji used (e.g., ❤️, 👍)
  
  // Self relation for reacting to comments
  parentId    String?         @map("parent_id")
  parent      DiaryReaction?  @relation("ReactionToReaction", fields: [parentId], references: [id], onDelete: Cascade)
  replies     DiaryReaction[] @relation("ReactionToReaction")

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("diary_reactions")
}

model Mood {
  id        String   @id @default(uuid())
  couple    Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId  String   @map("couple_id")
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id")
  mood      String   // happy | grumpy | low | productive | missing_you
  note      String?  // optional one-line context the partner sees with the mood
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([coupleId, userId])
  @@map("moods")
}

model Coupon {
  id           String    @id @default(uuid())
  couple       Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId     String    @map("couple_id")
  creator      User      @relation("CouponCreator", fields: [creatorId], references: [id])
  creatorId    String    @map("creator_id")
  recipient    User      @relation("CouponRecipient", fields: [recipientId], references: [id])
  recipientId  String    @map("recipient_id")
  title        String
  description  String?
  status       String    @default("active") // active | pending | used | fulfilled | expired
  expiresAt    DateTime? @map("expires_at")
  redeemedAt   DateTime? @map("redeemed_at")
  fulfilledAt  DateTime? @map("fulfilled_at")
  reviewRating Int?      @map("review_rating")
  reviewText   String?   @map("review_text")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model LoveReason {
  id          String    @id @default(uuid())
  couple      Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId    String    @map("couple_id")
  author      User      @relation("ReasonAuthor", fields: [authorId], references: [id])
  authorId    String    @map("author_id")
  forUser     User      @relation("ReasonRecipient", fields: [forUserId], references: [id])
  forUserId   String    @map("for_user_id")
  reason      String
  image       String?
  used        Boolean   @default(false)
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("love_reasons")
}

model VaultFile {
  id           String   @id @default(uuid())
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String   @map("owner_id")
  // Idempotency token mirroring Message/DiaryEntry — lets the upload retry queue
  // collapse a re-attempted insert into the same row.
  clientId     String?  @map("client_id")
  fileUrl      String   @map("file_url")
  fileType     String   @map("file_type") // image | video
  thumbnailUrl String?  @map("thumbnail_url")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ownerId, createdAt])
  @@unique([ownerId, clientId], name: "vault_owner_client_id_unique")
  @@map("vault_files")
}

model Message {
  id              String   @id @default(uuid())
  couple          Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId        String   @map("couple_id")
  sender          User     @relation("SentMessages", fields: [senderId], references: [id])
  senderId        String   @map("sender_id")
  senderDeviceId  String?  @map("sender_device_id")
  senderDevice    Device?  @relation("MessageSenderDevice", fields: [senderDeviceId], references: [id], onDelete: SetNull)
  // Client-supplied idempotency token. Combined with senderId via the unique index below
  // so a retried `send_message` returns the existing row instead of creating a duplicate.
  clientId        String?  @map("client_id")
  content         String?
  mediaUrl        String?  @map("media_url")
  mediaType       String?  @map("media_type")
  senderAesKey      String?  @map("sender_aes_key")
  recipientAesKey   String?  @map("recipient_aes_key")
  status            String   @default("sent")
  encryptionVersion String?  @map("encryption_version")
  keyEpochVersion   Int?     @map("key_epoch_version")
  wrappedContentKey String?  @map("wrapped_content_key")

  deletedForSender  Boolean  @default(false) @map("deleted_for_sender")
  deletedForEveryone Boolean @default(false) @map("deleted_for_everyone")
  deletedAt         DateTime? @map("deleted_at")
  editedAt          DateTime? @map("edited_at")
  reactions         Json?    @default("{}")
  deliveredAt       DateTime? @map("delivered_at")
  readAt            DateTime? @map("read_at")

  createdAt         DateTime @default(now()) @map("created_at")

  @@index([coupleId, createdAt])
  @@index([coupleId, createdAt, id])
  @@index([senderDeviceId])
  // Postgres treats NULL values as distinct by default, so multiple rows with
  // `client_id IS NULL` coexist while non-null duplicates for the same sender are
  // rejected. This is what gives `send_message` its idempotency.
  @@unique([senderId, clientId], name: "sender_client_id_unique")
  @@map("messages")
}

model Device {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @map("user_id")
  name         String?
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  lastSeenAt   DateTime? @map("last_seen_at")
  revokedAt    DateTime? @map("revoked_at")
  keys         DeviceKey[]
  envelopes    ConversationDeviceEnvelope[]
  sentMessages Message[] @relation("MessageSenderDevice")
  pairingChallengesCreated PairingChallenge[] @relation("PairingChallengeCreator")
  pairingChallengesTargeted PairingChallenge[] @relation("PairingChallengeTarget")

  @@index([userId, status])
  @@map("chat_devices")
}

model PairingChallenge {
  id                 String   @id @default(uuid())
  creatorDevice      Device   @relation("PairingChallengeCreator", fields: [creatorDeviceId], references: [id], onDelete: Cascade)
  creatorDeviceId    String   @map("creator_device_id")
  targetDevice       Device   @relation("PairingChallengeTarget", fields: [targetDeviceId], references: [id], onDelete: Cascade)
  targetDeviceId     String   @map("target_device_id")
  tokenHash          String   @unique @map("token_hash")
  expiresAt          DateTime @map("expires_at")
  usedAt             DateTime? @map("used_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([targetDeviceId, expiresAt])
  @@index([creatorDeviceId, expiresAt])
  @@map("chat_pairing_challenges")
}

model DeviceKey {
  id          String   @id @default(uuid())
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId    String   @map("device_id")
  publicKey   String   @map("public_key")
  keyVersion  Int      @map("key_version")
  createdAt   DateTime @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  @@unique([deviceId, keyVersion])
  @@index([deviceId, createdAt])
  @@map("chat_device_keys")
}

model ConversationKeyEpoch {
  id          String   @id @default(uuid())
  couple      Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId    String   @map("couple_id")
  version     Int
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  retiredAt   DateTime? @map("retired_at")
  creationRequestId String? @unique @map("creation_request_id")
  envelopes   ConversationDeviceEnvelope[]

  @@unique([coupleId, version])
  @@index([coupleId, status])
  @@map("conversation_key_epochs")
}

model ConversationDeviceEnvelope {
  id              String   @id @default(uuid())
  epoch           ConversationKeyEpoch @relation(fields: [epochId], references: [id], onDelete: Cascade)
  epochId         String   @map("epoch_id")
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId         String   @map("device_id")
  keyVersion       Int      @map("key_version")
  wrappedEpochKey  String   @map("wrapped_epoch_key")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([epochId, deviceId])
  @@index([deviceId, createdAt])
  @@map("conversation_device_envelopes")
}

model RecoveryKeyEnvelope {
  id                   String   @id @default(uuid())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String   @map("user_id")
  encryptionVersion    String   @map("encryption_version")
  kdfAlgorithm         String   @map("kdf_algorithm")
  kdfParameters        Json     @map("kdf_parameters")
  salt                 String
  nonce                String
  encryptedRecoveryKey String   @map("encrypted_recovery_key")
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([userId, encryptionVersion])
  @@map("recovery_key_envelopes")
}

model RecoveryConversationEnvelope {
  id                 String   @id @default(uuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String   @map("user_id")
  couple             Couple   @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  coupleId           String   @map("couple_id")
  epochVersion       Int      @map("epoch_version")
  nonce              String
  encryptedEpochKey  String   @map("encrypted_epoch_key")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([userId, coupleId, epochVersion])
  @@index([userId, coupleId])
  @@map("recovery_conversation_envelopes")
}
